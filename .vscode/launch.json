{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Client (Electron)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/start_visualization.ps1 -Mode client"
    },
    {
      "name": "Backend",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.py",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1",
        "AI2050_SKIP_MODEL_LOAD": "1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Client)",
      "configurations": [
        "Backend",
        "Client (Electron)"
      ],
      "stopAll": false
    }
  ]
}
