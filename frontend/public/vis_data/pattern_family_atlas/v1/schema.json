{
  "schema_version": "1.0.0",
  "program_id": "pattern_family_atlas_v1",
  "record_types": {
    "family": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "family_id",
        "family_name",
        "priority",
        "status",
        "progress"
      ]
    },
    "mode": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "mode_id",
        "family_id",
        "mode_name",
        "status",
        "progress",
        "expected_internal_path"
      ]
    },
    "test_case": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "case_id",
        "family_id",
        "mode_id",
        "prompt",
        "target",
        "expected_pattern"
      ]
    },
    "run": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "run_id",
        "model",
        "status",
        "started_at"
      ]
    },
    "observation": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "observation_id",
        "run_id",
        "case_id",
        "model",
        "family_id",
        "mode_id",
        "level",
        "metric_name",
        "metric_value"
      ]
    },
    "metric": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "metric_id",
        "scope",
        "metric_name",
        "metric_value"
      ]
    },
    "graph_node": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "node_id",
        "node_type",
        "label",
        "status",
        "evidence_score",
        "progress"
      ]
    },
    "graph_edge": {
      "required": [
        "schema_version",
        "phase_id",
        "created_at",
        "edge_id",
        "source",
        "target",
        "edge_type",
        "evidence_type",
        "confidence"
      ]
    }
  },
  "status_order": [
    "not_started",
    "behavior_tested",
    "trigger_mapped",
    "state_mapped",
    "readout_mapped",
    "source_candidate",
    "hook_supported",
    "closure_candidate",
    "closed",
    "failed_or_deprioritized"
  ],
  "evidence_weights": {
    "behavior_consistency": 0.15,
    "state_consistency": 0.15,
    "readout_consistency": 0.2,
    "hook_causal_support": 0.25,
    "closure_support": 0.15,
    "cross_model_consistency": 0.1
  }
}
