{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2050.local/schemas/experiment_contract.schema.json",
  "title": "AI2050 Experiment Contract",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "campaign_id",
    "work_package_id",
    "title",
    "status",
    "question",
    "construct_types",
    "puzzle_ids",
    "hypothesis_predictions",
    "scope",
    "data_contract",
    "controls",
    "metrics",
    "typed_gates",
    "budget",
    "stopping_rules",
    "adjudication",
    "permissions",
    "audit",
    "frozen_artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+$"},
    "campaign_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
    "work_package_id": {"type": "string", "pattern": "^WP[0-9]{2}$"},
    "phase": {"type": ["integer", "null"]},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "calibrated", "preregistered", "ready", "running", "auditing", "adjudicated", "blocked", "censored", "invalid", "archived"]},
    "question": {"type": "string", "minLength": 1},
    "construct_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "puzzle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P[0-9]{2}$"}},
    "hypothesis_predictions": {"type": "array", "minItems": 1},
    "scope": {"type": "object"},
    "data_contract": {"type": "object"},
    "factor_design": {"type": "object"},
    "event_registry": {"type": "array"},
    "intervention_registry": {"type": "array"},
    "readout_registry": {"type": "array"},
    "controls": {"type": "array", "minItems": 1},
    "metrics": {"type": "array", "minItems": 1},
    "typed_gates": {"type": "array", "minItems": 1},
    "budget": {"type": "object"},
    "stopping_rules": {"type": "array", "minItems": 1},
    "adjudication": {"type": "object"},
    "permissions": {"type": "object"},
    "audit": {"type": "object"},
    "frozen_artifacts": {"type": "object"}
  },
  "additionalProperties": true
}

