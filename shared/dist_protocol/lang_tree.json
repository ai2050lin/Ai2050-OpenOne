    {"id": "RS.TASK", "category": "RS.task", "name": "任务线索", "desc": "提示语指定的任务（翻译、判断、补全……）", "languages": ["zh", "en"]},
    {"id": "GR.Q", "category": "GR.clause", "name": "疑问 / 陈述", "desc": "句子是疑问还是陈述（含嵌入式疑问，句末标点一致）", "languages": ["zh"]},
    {"id": "GR.ROLE", "category": "GR.argument", "name": "施事 / 受事", "desc": "名词在事件中是施事还是受事", "languages": ["zh"]},
    {"id": "GR.CONSTR", "category": "GR.construction", "name": "主动 / 把字 / 被字", "desc": "同一事件的不同句式", "languages": ["zh"]},
    {"id": "EXT.LANG", "category": "EXT.language", "name": "语种识别", "desc": "输入是中文还是英文", "languages": ["zh", "en"]},
    {"id": "EXT.FRAME", "category": "EXT.surface", "name": "提问表述变体", "desc": "同一分类任务的不同提示框架；材料控制标签，不代表疑问/陈述或模型内部独立模块", "languages": ["en"]},
    {"id": "EXT.SOURCE_ORDER", "category": "EXT.surface", "name": "信息源呈现顺序", "desc": "档案块在提示中先后位置的交换，保留来源内记录及问题指定的来源和实体；属于位置控制，不等同于语法语序或事件时间顺序", "languages": ["en"]},
    {"id": "EXT.SOURCE_WORDING", "category": "EXT.surface", "name": "来源查询表述变体", "desc": "同一档案记录与来源查询的等义表述框架；按模板标注，不代表不同句类或已证明相同的内部算法", "languages": ["en"]},
    {"id": "EXT.RULE_PRESENTATION", "category": "EXT.surface", "name": "规则呈现方式", "desc": "指令、参考或被引用的描述、无关系清单等外部材料条件；规则是否生效的理解另需行为检验，不是神经元语义标签", "languages": ["en"]},
    {"id": "EXT.TECHNICAL_TITLE", "category": "EXT.surface", "name": "无关技术词标题", "desc": "材料标题是否包含技术词；标题明确不构成操作指令，不等于正文的语义关系或模型内部主题模块", "languages": ["en"]},
    {"id": "EXT.RULE_WORDING", "category": "EXT.surface", "name": "关系描述句式", "desc": "同一配对或次序变换关系的不同句式框架；按材料生成规则标注，未声称内部实现相同", "languages": ["en"]}
