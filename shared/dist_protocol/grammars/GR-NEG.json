    "polarity": "neg",
    "mood": "decl"
   },
   "text": "我想说，{S}不是{A}的。",
   "target": "A",
   "probe": {
    "prompt": "判断对错：{S}不是{A}的。答案：",
    "answer": "错"
   }
  },
  {
   "id": "aff-q",
   "levels": {
    "polarity": "aff",
    "mood": "interrog"
   },
   "text": "我想问，{S}是{A}的吗？",
   "target": "A",
   "probe": {
    "prompt": "问：{S}是{A}的吗？答：{S}",
    "answer": "是"
   }
  },
  {
   "id": "neg-q",
   "levels": {
    "polarity": "neg",
    "mood": "interrog"
   },
   "text": "我想问，{S}不是{A}的吗？",
   "target": "A",
   "probe": {
    "prompt": "问：{S}不是{A}的吗？答：{S}",
    "answer": "是"
   }
  }
 ],
