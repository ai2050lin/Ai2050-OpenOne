{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2050.local/schemas/language_graph_targets.v1.schema.json",
  "title": "AI2050 Language Graph Distributed Test Targets v1",
  "type": "object",
  "required": ["schema_version", "revision", "progress_policy", "domains", "milestones", "targets"],
  "properties": {
    "schema_version": {"const": "language-graph-targets.v1"},
    "revision": {"type": "integer", "minimum": 1},
    "progress_policy": {"type": "object"},
    "domains": {"type": "array", "minItems": 1},
    "milestones": {"type": "array", "minItems": 1},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family_id", "label", "domain_id", "research_question", "graph_nodes", "graph_edges", "test_matrix"],
        "properties": {
          "id": {"type": "string", "pattern": "^LG-[A-Z0-9-]+$"},
          "family_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "domain_id": {"type": "string", "minLength": 1},
          "research_question": {"type": "string", "minLength": 1},
          "graph_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "graph_edges": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "test_matrix": {
            "type": "object",
            "required": ["contrasts", "controls", "holdouts", "distributed_shards", "required_outputs"],
            "properties": {
              "contrasts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "holdouts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "distributed_shards": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "existing_records": {"type": "array"}
        }
      }
    }
  },
  "additionalProperties": false
}
